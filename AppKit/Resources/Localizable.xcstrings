    "Téléchargements": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads"
          }
        }
      }
    },
    "Une copie de ces catégories n’est plus gardée. Celles déjà gardées restent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies in these categories are no longer kept. Those already kept stay."
          }
        }
      }
    },
    "Utiliser %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        }
      }
    },
    "Voir toutes les copies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show All Copies"
          }
        }
      }
    },
    "Volumineux · temporaire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large · temporary"
          }
        }
      }
    },
    "Vos copies restent sur ce Mac, chiffrées.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your copies stay on this Mac, encrypted."
          }
        }
      }
    },
    "Votre historique est chiffré avec une clé introuvable sur ce Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your history is encrypted with a key that can’t be found on this Mac"
          }
        }
      }
    },
    "Vous avez copié « %@ », rangé dans %@. Pour l’afficher et le recoller, AppKit doit lire ce fichier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You copied “%1$@”, stored in %2$@. To show it and paste it back, AppKit needs to read this file."
          }
        }
      }
    },
    "Vous entendez que la copie est dans l’historique.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hear that the copy is in the history."
          }
        }
      }
    },
    "Vous entendez qu’une copie n’a pas été gardée, sans rien voir de son contenu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hear that a copy wasn’t kept, without seeing anything of it."
          }
        }
      }
    },
    "macOS a refusé ce changement. Réessayez depuis les Réglages Système.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused this change. Try again from System Settings."
          }
        }
      }
    },
    "macOS va vous demander l’accès au dossier %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask for access to the %@ folder"
          }
        }
      }
    },

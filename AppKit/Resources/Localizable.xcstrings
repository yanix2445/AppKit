    "Activer le collage direct": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Direct Paste"
          }
        }
      }
    },
    "Annuler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "App inconnue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown app"
          }
        }
      }
    },
    "AppKit n’a rien effacé. La clé est rangée dans le Trousseau de ce Mac : elle a peut-être été supprimée, ou pas encore restaurée.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppKit has erased nothing. The key is kept in this Mac’s keychain: it may have been deleted, or not restored yet."
          }
        }
      }
    },
    "Aucune copie n’est écrite en clair.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copy is written in clear."
          }
        }
      }
    },
    "Aucune copie pour l’instant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No copies yet"
          }
        }
      }
    },
    "Autoriser le collage direct": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Direct Paste"
          }
        }
      }
    },
    "Capture en pause · clé inaccessible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture paused · key unavailable"
          }
        }
      }
    },
    "Capture en pause · clé introuvable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture paused · key not found"
          }
        }
      }
    },
    "Capture en pause · disque plein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture paused · disk full"
          }
        }
      }
    },
    "Celles qu’une app crée seule, sans que vous ayez copié quoi que ce soit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those an app creates by itself, without you copying anything."
          }
        }
      }
    },
    "Choisissez un autre raccourci pour ouvrir l’historique.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another shortcut to open the history."
          }
        }
      }
    },
    "Coller": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste"
          }
        }
      }
    },
    "Coller en texte brut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste as Plain Text"
          }
        }
      }
    },
    "Confidentialité": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "Copié · faites": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied · press"
          }
        }
      }
    },
    "Copié · faites ⌘V": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied · press ⌘V"
          }
        }
      }
    },
    "Déjà pris": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken"
          }
        }
      }
    },
    "En attendant, la capture est en pause : aucune copie n’est écrite en clair.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meanwhile, capture is paused: no copy is written in clear."
          }
        }
      }
    },
    "Garder les copies générées automatiquement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep automatically generated copies"
          }
        }
      }
    },
    "Historique des copies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy history"
          }
        }
      }
    },
    "Jamais gardés, et jamais écrits sur le disque, même temporairement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never kept, and never written to disk, even temporarily."
          }
        }
      }
    },
    "La capture reprendra seule dès que la clé sera accessible. Aucune copie n’est écrite en clair.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture will resume by itself once the key is available. No copy is written in clear."
          }
        }
      }
    },
    "La capture reprendra seule dès qu’il y aura de la place. Aucune copie n’est écrite à moitié.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture will resume by itself once there is room. No copy is written by halves."
          }
        }
      }
    },
    "Le bandeau reste accessible par l’icône de la barre de menus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strip stays available from the menu bar icon."
          }
        }
      }
    },
    "Libre": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available"
          }
        }
      }
    },
    "Libérer de la place…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Up Space…"
          }
        }
      }
    },
    "Mots de passe et copies confidentielles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords and confidential copies"
          }
        }
      }
    },
    "Ouvrir les Réglages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Ouvrir l’historique": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open History"
          }
        }
      }
    },
    "Plus tard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        }
      }
    },
    "Pour coller directement dans l’app que vous utilisez, AppKit a besoin de la permission Accessibilité. Sans elle, l’élément sera simplement copié et vous ferez ⌘V.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste directly into the app you’re using, AppKit needs the Accessibility permission. Without it, the item is simply copied and you press ⌘V."
          }
        }
      }
    },
    "Quitter AppKit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit AppKit"
          }
        }
      }
    },
    "Repartir à zéro…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Over…"
          }
        }
      }
    },
    "Réessayer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        }
      }
    },
    "Réglages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Réglages Système › Confidentialité et sécurité › Accessibilité": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › Privacy & Security › Accessibility"
          }
        }
      }
    },
    "Réglages…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "Sans sa clé, cet historique ne peut plus être lu. Sa suppression est définitive, même si la clé réapparaît ensuite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without its key, this history can no longer be read. Deleting it is permanent, even if the key turns up later."
          }
        }
      }
    },
    "Supprimer tout l’historique, épinglés compris ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the entire history, pinned items included?"
          }
        }
      }
    },

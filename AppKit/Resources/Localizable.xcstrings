    "Tout effacer…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase All…"
          }
        }
      }
    },
    "Tout l’historique sera effacé. Les éléments épinglés et les copies volumineuses temporaires ne sont pas touchés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entire history will be erased. Pinned items and temporary large copies are left alone."
          }
        }
      }
    },
    "Tout rétablir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore All"
          }
        }
